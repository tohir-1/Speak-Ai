# ===== TELEGRAM =====
# @BotFather dan olingan token
BOT_TOKEN=
# Bot adminlari Telegram ID lari (vergul bilan). ID ni @userinfobot dan bilib oling
ADMIN_TELEGRAM_IDS=
# (ixtiyoriy) Lokal Telegram Bot API server manzili (20 MB dan katta fayllar uchun)
TELEGRAM_API_ROOT=

# ===== ADMIN PANEL =====
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3000
# Kamida 32 ta tasodifiy belgi. Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Birinchi adminni avtomatik yaratish uchun (faqat admins jadvali bo'sh bo'lganda)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# HTTPS orqasida ishlasangiz true qiling
COOKIE_SECURE=false

# ===== LIMITLAR =====
MAX_FILE_MB=20
MAX_DURATION_SEC=600
MAX_TTS_CHARS=1000
MAX_TEXT_CHARS=8000
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SEC=60
JOB_CONCURRENCY=2
TEMP_TTL_MINUTES=30

# ===== FFMPEG (PATH da bo'lsa o'zgartirmang) =====
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ===== AI SERVICE (Python) =====
AI_SERVICE_URL=http://127.0.0.1:8008
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8008
# Node va Python o'rtasidagi umumiy maxfiy kalit (ixtiyoriy, lekin tavsiya etiladi)
AI_SERVICE_TOKEN=
AI_TIMEOUT_MS=600000

# Whisper: tiny | base | small | medium | large-v3  (kattasi aniqroq, lekin sekin va ko'p RAM talab qiladi)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Tarjima modeli (NLLB). 600M yengil, 1.3B aniqroq
NLLB_MODEL=facebook/nllb-200-distilled-600M

# (ixtiyoriy) Lokal LLM — Ollama o'rnatilgan bo'lsa AI Xulosa sifati ancha yaxshi bo'ladi
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# (ixtiyoriy) Piper — erkak/ayol ovozlari uchun. Papkada: uz-male.onnx, ru-female.onnx kabi fayllar
PIPER_BIN=piper
PIPER_MODELS_DIR=
